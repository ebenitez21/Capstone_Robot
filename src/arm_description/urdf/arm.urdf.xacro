      </geometry>
    </collision>
  </link>

  <!-- JOINT 4: Forearm Roll (Z-axis) | P4 - P3 = [-0.00942, -0.01460, 0.13476] -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="-0.00942 -0.01460 0.13476" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="20.0" velocity="2.0"/>
  </joint>

  <!-- LINK 4 (-P4) -->
  <link name="link_4">
    <visual>
      <origin xyz="-0.08143 -0.25100 -0.37499" rpy="0 0 0"/>
      <geometry>
        <mesh filename="https://shadowy-skeleton-r7wv77x7v6gp3w5qr-8080.app.github.dev/link_4.stl" scale="0.001 0.001 0.001"/>
