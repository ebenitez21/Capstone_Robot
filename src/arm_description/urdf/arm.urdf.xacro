    </visual>
    <collision>
      <origin xyz="-0.08143 -0.25100 -0.37499" rpy="0 0 0"/>
      <geometry>
        <mesh filename="https://shadowy-skeleton-r7wv77x7v6gp3w5qr-8080.app.github.dev/link_4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- JOINT 5: Wrist Pitch (X-axis) | P5 - P4 = [-0.03334, -0.04756, 0.19314] -->
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="-0.03334 -0.04756 0.19314" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="20.0" velocity="2.0"/>
  </joint>

  <!-- LINK 5 (-P5) -->
  <link name="link_5">
    <visual>
      <origin xyz="-0.04809 -0.20344 -0.56813" rpy="0 0 0"/>
      <geometry>
        <mesh filename="https://shadowy-skeleton-r7wv77x7v6gp3w5qr-8080.app.github.dev/link_5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.04809 -0.20344 -0.56813" rpy="0 0 0"/>
      <geometry>
        <mesh filename="https://shadowy-skeleton-r7wv77x7v6gp3w5qr-8080.app.github.dev/link_5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- JOINT 6: Flange Roll (Z-axis) | P6 - P5 = [-0.02012, -0.03622, 0.01608] -->
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="link_6"/>
    <origin xyz="-0.02012 -0.03622 0.01608" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10.0" velocity="2.5"/>
  </joint>

  <!-- LINK 6 (-P6) -->
  <link name="link_6">
    <visual>
      <origin xyz="-0.02797 -0.16722 -0.58421" rpy="0 0 0"/>
      <geometry>
        <mesh filename="https://shadowy-skeleton-r7wv77x7v6gp3w5qr-8080.app.github.dev/link_6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.02797 -0.16722 -0.58421" rpy="0 0 0"/>
      <geometry>
        <mesh filename="https://shadowy-skeleton-r7wv77x7v6gp3w5qr-8080.app.github.dev/link_6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

</robot>