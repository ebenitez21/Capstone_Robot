<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_link">
    <!-- 3D Graphics / Rendering -->
    <visual>
      <origin xyz="0 0 0.227" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/example.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.4 0.8 1.0"/>
      </material>
    </visual>

    <!-- Physical Physics / Hitbox -->
    <collision>
      <origin xyz="0 0 0.277" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/example.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

</robot>